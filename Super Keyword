
class Animal {
    String name = "Animal";

    void display() {
        System.out.println("This is Animal class");
    }
}

class Dog extends Animal {
    String name = "Dog";

    void show() {
        System.out.println("Child class name: " + name);
        System.out.println("Parent class name: " + super.name);

        super.display();
    }

    public static void main(String[] args) {
        Dog d = new Dog();
        d.show();
    }
}
