class Rectangle {
    // Declaring fields
    int length;
    int width;

    // Method to calculate area
    void CalculateArea() {
        int area = length * width;
        System.out.println("Area of Rectangle = " + area);
    }

    public static void main(String[] args) {
        // Creating object of Rectangle class
        Rectangle r = new Rectangle();

        // Assigning values
        r.length = 10;
        r.width = 5;

        // Calling method
        r.CalculateArea();
    }
}
 
